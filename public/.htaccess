# Apache config for the static dist/. Astro preview ignores this file.
# TODO: confirm Matt wants the bare domain. These rules send www to the bare host.

Options -Indexes

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
	AddType video/webm .webm
	AddType image/avif .avif
	AddType font/woff2 .woff2
	AddType image/webp .webp
</IfModule>

<IfModule mod_setenvif.c>
	SetEnvIf Request_URI "^/(_astro|fonts|media)/" long_cache
</IfModule>

<IfModule mod_headers.c>
	Header set Cache-Control "public, max-age=300, must-revalidate"
	Header set Cache-Control "public, max-age=31536000, immutable" env=long_cache
</IfModule>

<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# Old placeholder guide slugs
Redirect 301 /guides/todo-older-live-1 /guides/antihero-website-masterclass
Redirect 301 /guides/todo-older-live-2 /guides/email-the-channel-nobody-can-take
Redirect 301 /guides/todo-older-live-1.pdf /guides/antihero-website-masterclass.pdf
Redirect 301 /guides/todo-older-live-2.pdf /guides/email-the-channel-nobody-can-take.pdf

