---
interface Props {
	/** Path stem with no extension, such as /media/loops/guide-websites-on-autopilot. */
	stem?: string | null;
	poster: string;
	aspect: "4:5" | "16:9";
	class?: string;
	/** Video cards. Phones keep the poster. Laptops play it on hover. */
	desktopOnly?: boolean;
}

const { stem = null, poster, aspect, class: className, desktopOnly = false } = Astro.props;
const avif = poster.replace(/\.jpe?g$/i, ".avif");
const webm = stem ? `${stem}.webm` : null;
const mp4 = stem ? `${stem}.mp4` : null;
const ratio = aspect === "16:9" ? "16 / 9" : "4 / 5";
const width = aspect === "16:9" ? 1280 : 864;
const height = aspect === "16:9" ? 720 : 1080;
---

<div
	class:list={["hover-video", className]}
	data-hover-video
	data-aspect={aspect}
	data-hover-desktop={desktopOnly ? "true" : undefined}
	style={`--hover-aspect: ${ratio};`}
>
	<picture>
		<source srcset={avif} type="image/avif" />
		<img src={poster} alt="" width={width} height={height} decoding="async" />
	</picture>
	{
		webm && mp4 && (
			<video
				muted
				loop
				playsinline
				preload="none"
				disablepictureinpicture
				tabindex="-1"
				aria-hidden="true"
				width={width}
				height={height}
			>
				<source data-src={webm} type="video/webm" />
				<source data-src={mp4} type="video/mp4" />
			</video>
		)
	}
</div>

<script>
	import { bootHoverVideos } from "../scripts/hover-video";

	bootHoverVideos();
</script>

<style>
	.hover-video {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		overflow: hidden;
		aspect-ratio: var(--hover-aspect);
		background: var(--color-carbon);
	}

	.hover-video picture,
	.hover-video img,
	.hover-video video {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hover-video video {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s linear;
	}

	.hover-video.is-on video {
		opacity: 1;
		transition-duration: 0.35s;
	}

	@media (prefers-reduced-motion: reduce) {
		.hover-video video {
			display: none;
		}
	}
</style>
