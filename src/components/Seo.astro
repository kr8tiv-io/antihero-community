---
import { SITE_URL } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title,
  description,
  image = "/og/og.jpg",
  canonical,
  type = "website",
} = Astro.props;

const pageTitle = title.includes("AntiHero") ? title : `${title} · AntiHero AI`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(image, SITE_URL).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:site_name" content="AntiHero AI" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
