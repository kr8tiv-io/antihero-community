---
import { facebookGroupUrl, isCurrentPath, menuLinks } from "../data/nav";

const path = Astro.url.pathname;
---

<div
	id="site-menu"
	class="menu-overlay"
	data-menu
	role="dialog"
	aria-modal="true"
	aria-label="Menu"
	hidden
	transition:persist="site-menu"
	transition:name="site-menu"
	transition:animate="none"
>
	<nav class="menu-overlay__nav" aria-label="Sections">
		<ul class="menu-list" data-menu-list>
			{
				menuLinks.map((link) => (
					<li>
						<a
							class="menu-link"
							href={link.href}
							data-menu-item
							data-nav
							data-label={link.label}
							aria-current={isCurrentPath(link.href, path) ? "page" : undefined}
						>
							<span class="label-box label-box--white">{link.label}</span>
							<span class="menu-link__caption" aria-hidden="true">{link.caption}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<a
		class="menu-join label-box label-box--red"
		href={facebookGroupUrl}
		data-menu-item
		data-tracer="outline"
		data-tracer-hot
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Join the group (opens in a new tab)"
		data-cursor="Join"
		data-magnetic="true"
	>
		<span class="swap-label">
			<span class="swap-label__line">Join the group</span>
			<span class="swap-label__line" aria-hidden="true">Join the group</span>
		</span>
	</a>
</div>

<style>
	.menu-overlay {
		position: fixed;
		inset: 0;
		z-index: 30;
		display: flex;
		flex-direction: column;
		background: var(--color-anti);
		padding-top: var(--header-h);
		visibility: hidden;
	}

	.menu-overlay[hidden] {
		display: none;
	}

	.menu-overlay__nav {
		flex: 1;
		min-height: 0;
		overflow: auto;
		overscroll-behavior: contain;
		padding: var(--space-16) var(--space-16) var(--space-8);
	}

	.menu-list {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-12);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.menu-link {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--space-8) var(--space-16);
		max-width: 100%;
		color: inherit;
		text-decoration: none;
	}

	.menu-link:focus-visible {
		outline: 2px solid var(--color-ignition);
		outline-offset: 4px;
	}

	.menu-link .label-box {
		font-size: clamp(2.75rem, 13vw, 6rem);
	}

	.menu-link[aria-current="page"] .label-box {
		box-shadow: inset 0 -2px 0 var(--color-ignition);
	}

	.menu-link__caption {
		padding-bottom: 0.45em;
		color: var(--color-ash);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.3;
		text-transform: none;
	}

	.menu-join {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		align-self: stretch;
		min-height: 44px;
		margin: 0 var(--space-16) calc(var(--space-16) + env(safe-area-inset-bottom));
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		text-align: center;
		text-decoration: none;
	}

	.menu-join:focus-visible {
		outline: 2px solid var(--color-ignition);
		outline-offset: 4px;
	}

	.menu-overlay [data-menu-item] {
		opacity: 0;
		transform: translateY(24px);
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-overlay {
			visibility: visible;
		}

		.menu-overlay [data-menu-item] {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-height: 520px) {
		.menu-overlay__nav {
			padding-top: 0;
			padding-bottom: 0;
		}

		.menu-list {
			gap: 0;
		}

		.menu-link {
			align-items: center;
			min-height: 44px;
		}

		.menu-link .label-box {
			font-size: clamp(1.5rem, 6.5vh, 2.15rem);
		}

		.menu-join {
			min-height: 44px;
			margin-bottom: env(safe-area-inset-bottom);
			font-size: 1.35rem;
		}
	}

	@media (min-width: 1024px) {
		.menu-overlay {
			display: none;
		}
	}
</style>
