---
import HoverVideo from "./HoverVideo.astro";
import Raster from "./Raster.astro";
import RevealHeading from "./RevealHeading.astro";

interface Props {
	id: string;
	title: string;
	dateIso: string;
	dateLabel: string;
	duration: string | null;
	poster: string | null;
	/** Stem such as /media/loops/video-websites-on-autopilot-live. */
	loop?: string | null;
	guideHref: string | null;
	guideTitle: string | null;
	lead: boolean;
	compact?: boolean;
	/** No local file yet. The poster links to the Facebook post. The title opens the page. */
	placeholder?: boolean;
	fbUrl?: string | null;
}

const {
	id,
	title,
	dateIso,
	dateLabel,
	duration,
	poster,
	loop = null,
	guideHref,
	guideTitle,
	lead,
	compact = false,
	placeholder = false,
	fbUrl = null,
} = Astro.props;

const pageHref = `/videos/${id}`;
const watchHref = placeholder && fbUrl ? fbUrl : pageHref;
const external = watchHref.startsWith("http");
const watchLabel = placeholder ? "Watch on Facebook" : "Play";
---

<article
	class:list={["video-card", lead && "video-card--lead", compact && "video-card--compact"]}
	id={id}
	data-video-card
	data-hover-card
	data-lead={lead ? "true" : "false"}
	data-placeholder={placeholder ? "true" : "false"}
>
	<div class="video-card__frame" data-tracer="edge">
		<a
			class="video-hit"
			href={watchHref}
			target={external ? "_blank" : undefined}
			rel={external ? "noopener noreferrer" : undefined}
			data-cursor={placeholder ? "Watch" : "Play"}
		>
			<span class="video-card__media" data-video-media>
				<span class="video-card__zoom" data-zoom>
					{
						loop ? (
							<HoverVideo
								stem={loop}
								poster={poster ?? `${loop}-poster.jpg`}
								aspect="16:9"
								class="video-card__film"
								desktopOnly
							/>
						) : poster ? (
							<Raster
								src={poster}
								alt={`Still from ${title}.`}
								sizes="(min-width: 1024px) 48vw, 92vw"
								widths={[480, 800, 1280]}
								fallbackWidth={1280}
								fallbackHeight={720}
								reveal
							/>
						) : (
							<span class="video-card__plate">
								<span class="video-card__plate-note">Poster still to come.</span>
							</span>
						)
					}
				</span>
			</span>
			<span class:list={["label-box", "video-card__play", lead && "label-box--red"]} data-nudge>
				<span class="swap-label">
					<span class="swap-label__line">{watchLabel}</span>
					<span class="swap-label__line" aria-hidden="true">{watchLabel}</span>
				</span>
			</span>
			<span class="visually-hidden">
				{watchLabel} {title}
				{external ? ". Opens in a new tab." : "."}
			</span>
		</a>
	</div>

	<div class="video-card__body">
		<a class="video-card__title" href={pageHref}>
			<RevealHeading as="h2" text={title} wordsPerLine={compact ? 1 : 2} />
		</a>
		<p class="video-card__meta mono">
			<time datetime={dateIso}>{dateLabel}</time>
			{duration && <span>{duration}</span>}
		</p>
		{
			guideHref && guideTitle && (
				<a class="video-card__guide label" href={guideHref}>
					Guide: {guideTitle}
				</a>
			)
		}
	</div>
</article>

<style>
	.video-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-16);
		min-width: 0;
		scroll-margin-top: calc(var(--header-h) + var(--space-24));
	}

	.video-card__frame {
		width: 100%;
	}

	.video-hit {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.video-hit:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 4px;
	}

	.video-card__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-carbon);
	}

	.video-card__zoom {
		display: block;
		height: 100%;
	}

	.video-card__zoom :global(.video-card__film) {
		height: 100%;
		aspect-ratio: auto;
	}

	.video-card__zoom :global(picture),
	.video-card__zoom :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.video-card__plate {
		display: flex;
		align-items: flex-end;
		height: 100%;
		padding: var(--space-16);
		background: var(--color-carbon);
	}

	.video-card__plate-note {
		font-family: var(--font-label);
		font-size: var(--type-label-size);
		font-weight: 700;
		letter-spacing: var(--type-label-tracking);
		text-transform: uppercase;
		color: var(--color-hero);
	}

	.video-card__play {
		position: absolute;
		left: var(--space-16);
		bottom: var(--space-16);
		max-width: calc(100% - (var(--space-16) * 2));
		font-size: clamp(1.35rem, 3.2vw, 2rem);
	}

	.video-card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-8);
		max-width: 22ch;
		min-width: 0;
	}

	.video-card--compact .video-card__body {
		max-width: 100%;
	}

	.video-card__title {
		display: block;
		max-width: 100%;
		color: inherit;
		text-decoration: none;
	}

	.video-card__title:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 4px;
	}

	.video-card h2 {
		margin: 0;
		max-width: 100%;
		font-size: clamp(1.7rem, 2vw, 2.35rem);
		line-height: 0.9;
	}

	.video-card--compact h2 {
		font-size: clamp(1.35rem, 1.6vw, 1.7rem);
	}

	.video-card--lead h2 {
		font-size: clamp(2.6rem, 4.5vw, 4.75rem);
		line-height: 0.86;
		max-width: 100%;
	}

	@media (min-width: 900px) {
		.video-card--lead h2 {
			font-size: clamp(2rem, 2.4vw, 2.8rem);
		}
	}

	.video-card__meta {
		display: flex;
		gap: var(--space-16);
		margin: 0;
		color: var(--color-bone);
	}

	.video-card__guide {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-hero);
		text-decoration: none;
		text-underline-offset: 0.22em;
	}

	.video-card__guide:hover {
		text-decoration: underline;
	}

	.video-card__guide:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 3px;
	}


</style>
