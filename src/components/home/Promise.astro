---
/**
 * Home promise. Sits after the hero. Does not touch the hero film.
 * The loop is an ffmpeg derivation of the promise still. Posters are frame 0.
 */

const words: { text: string; rot: number; red?: boolean }[] = [
	{ text: "No", rot: -3 },
	{ text: "more", rot: 5 },
	{ text: "garbage", rot: -6 },
	{ text: "AI", rot: 4 },
	{ text: "slop", rot: 6, red: true },
	{ text: "websites.", rot: -4 },
];

const lines = [
	"Guides you can actually follow.",
	"Prompts tested on a live audience.",
	"Replays of every live.",
];
---

<section class="promise" data-promise aria-labelledby="promise-title">
	<div class="promise-stage" data-promise-stage>
		<div class="promise-photo" aria-hidden="true">
			<div class="promise-film" data-promise-film>
				<picture class="promise-still">
					<source
						media="(max-width: 767px)"
						srcset="/media/promise-loop-mobile-poster.avif"
						type="image/avif"
					/>
					<source
						media="(max-width: 767px)"
						srcset="/media/promise-loop-mobile-poster.webp"
						type="image/webp"
					/>
					<source srcset="/media/promise-loop-poster.avif" type="image/avif" />
					<source srcset="/media/promise-loop-poster.webp" type="image/webp" />
					<img
						src="/media/promise-loop-poster.jpg"
						alt=""
						width="1920"
						height="1080"
						decoding="async"
					/>
				</picture>
				<video
					class="promise-video"
					data-promise-video
					muted
					loop
					playsinline
					preload="none"
					poster="/media/promise-loop-poster.jpg"
				></video>
			</div>
		</div>
		<div class="promise-shade" data-promise-shade aria-hidden="true"></div>
		<div class="promise-copy" data-promise-copy>
			<div class="promise-lead">
				<h2 id="promise-title" class="promise-title label-stack">
					{
						words.map((word) => (
							<span class="promise-word" data-promise-word data-rot={word.rot} style={`--rot: ${word.rot}deg`}>
								<span class:list={["label-box", { "label-box--red": word.red }]}>{word.text}</span>
							</span>
						))
					}
				</h2>
				<p class="promise-sub" data-promise-sub>Copy, paste, build something you're proud of.</p>
			</div>
			<ul class="promise-list">
				{lines.map((line) => <li class="mono" data-promise-line>{line}</li>)}
			</ul>
		</div>
	</div>
</section>

<script>
	import { bootPromise } from "../../scripts/home-promise";

	bootPromise();
</script>


<style>
	.promise {
		position: relative;
		z-index: 1;
		height: 210dvh;
		margin-top: calc(var(--hero-overlap, 58vh) * -1);
		overflow-x: clip;
		background: var(--color-anti);
	}

	.promise-stage {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100dvh;
		min-height: 0;
		overflow: hidden;
	}

	.promise-photo {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.promise-film {
		position: absolute;
		top: auto;
		right: auto;
		bottom: 0;
		left: -8%;
		width: 116%;
		height: auto;
		aspect-ratio: 1080 / 1350;
		transform-origin: center center;
	}

	/* Tall phones: the 4:5 frame is shorter than the stage. Cover it, and
	   keep the left of the frame so the spheres stay with the headline. */
	@media (max-width: 767px) and (min-height: 760px) {
		.promise-film {
			inset: 0;
			width: 100%;
			height: 100%;
			aspect-ratio: auto;
		}

		.promise-still,
		.promise-video,
		.promise-still img {
			object-position: 8% 70%;
		}
	}

	.promise-still,
	.promise-video,
	.promise-still img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}

	.promise-video {
		opacity: 0;
	}

	.promise-video.is-playing {
		opacity: 1;
	}

	.promise-shade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(to top, rgb(10 10 11 / 0.9) 0%, rgb(10 10 11 / 0.42) 42%, transparent 68%),
			linear-gradient(90deg, rgb(10 10 11 / 0.5), transparent 58%);
	}

	.promise-copy {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: var(--space-24);
		min-height: 100%;
		padding:
			calc(var(--header-h) + var(--space-32))
			var(--space-16)
			calc(var(--space-48) + env(safe-area-inset-bottom));
	}

	.promise-lead {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.promise-title {
		margin: 0;
		font-size: clamp(2.65rem, 13vw, 4.4rem);
	}

	.promise-word {
		display: block;
		width: fit-content;
		transform: rotate(var(--rot, 0deg));
		transform-origin: left center;
	}

	.promise-title .label-box--red:hover,
	.promise-title .label-box--red:active {
		background: var(--color-ignition);
	}

	.promise-sub {
		margin: var(--space-16) 0 0;
		max-width: 22ch;
		color: var(--color-bone);
	}

	.promise-list {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-12);
		width: max-content;
		max-width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.promise-list li {
		max-width: none;
		color: var(--color-hero);
		font-size: clamp(0.85rem, 3.2vw, 1rem);
	}

	@media (min-width: 768px) {
		.promise {
			height: 168vh;
		}

		.promise-stage {
			position: sticky;
			top: 0;
			height: 100vh;
			height: 100dvh;
			min-height: 0;
		}

		.promise-photo {
			top: -42%;
			right: auto;
			bottom: auto;
			left: 0;
			width: 100%;
			height: 184%;
		}

		.promise-film {
			inset: 0;
			width: 100%;
			height: 100%;
			aspect-ratio: auto;
		}

		.promise-shade {
			background:
				linear-gradient(to top, rgb(10 10 11 / 0.86) 0%, rgb(10 10 11 / 0.28) 40%, transparent 62%),
				linear-gradient(to bottom, rgb(10 10 11 / 0.55), transparent 32%);
		}

		.promise-copy {
			display: grid;
			grid-template-columns: max-content minmax(0, 1fr);
			grid-template-rows: auto 1fr;
			align-items: start;
			min-height: 100%;
			padding: calc(var(--header-h) + 4vh) 7vw 8vh;
		}

		.promise-lead {
			grid-column: 1;
			grid-row: 2;
			align-self: end;
		}

		.promise-title {
			font-size: clamp(2.8rem, 5.6vw, 4.8rem);
		}

		.promise-sub {
			max-width: 24ch;
			font-size: clamp(1.15rem, 1.4vw, 1.4rem);
		}

		.promise-list {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
			align-items: flex-end;
			text-align: right;
		}

		.promise-list li {
			font-size: clamp(0.9rem, 1.15vw, 1.05rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.promise {
			height: auto;
		}

		.promise-stage,
		.promise-copy {
			position: relative;
			height: auto;
			min-height: 100vh;
			min-height: 100dvh;
		}

		.promise-photo,
		.promise-film {
			top: 0;
			right: 0;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 100%;
			aspect-ratio: auto;
		}

		.promise-video {
			display: none;
		}
	}
</style>
