---
import { getCollection } from "astro:content";
import HoverVideo from "../HoverVideo.astro";

const guides = await getCollection("guides", ({ data }) => data.draft === false);
guides.sort((a, b) => {
	const byDate = b.data.date.getTime() - a.data.date.getTime();
	if (byDate !== 0) return byDate;
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.slug.localeCompare(b.data.slug);
});

const prompts = await getCollection("prompts");
prompts.sort((a, b) => b.data.order - a.data.order || a.id.localeCompare(b.id));

const videos = await getCollection("videos");
videos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));
const newestPlayable = videos.find((video) => video.data.placeholder !== true) ?? videos[0];

const posts = await getCollection("blog", ({ data }) => data.draft === false);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));

function countLine(count: number, one: string, many: string): string {
	return `${count} ${count === 1 ? one : many}`;
}

const doors = [
	{
		href: guides[0] ? `/guides/${guides[0].data.slug}` : "/guides",
		title: "Guides",
		line: countLine(guides.length, "guide", "guides"),
		stem: "/media/door-guides",
		poster: "/media/door-guides-poster.jpg",
	},
	{
		href: prompts[0] ? `/prompts#${encodeURIComponent(prompts[0].id)}` : "/prompts",
		title: "Prompts",
		line: countLine(prompts.length, "prompt", "prompts"),
		stem: "/media/door-prompts",
		poster: "/media/door-prompts-poster.jpg",
	},
	{
		href: newestPlayable ? `/videos/${newestPlayable.id}` : "/videos",
		title: "Videos",
		line: countLine(videos.length, "video", "videos"),
		stem: "/media/door-videos",
		poster: "/media/door-videos-poster.jpg",
	},
	{
		href: posts[0] ? `/blog/${posts[0].id}` : "/blog",
		title: "Blog",
		line: countLine(posts.length, "note", "notes"),
		stem: "/media/door-blog",
		poster: "/media/door-blog-poster.jpg",
	},
];
---

<section class="doors" data-doors aria-labelledby="doors-title">
	<div class="doors-head">
		<h2 id="doors-title" class="doors-title label-box label-box--white">Pick a door.</h2>
		<p class="doors-lead">Four ways in. All of them lead somewhere useful.</p>
	</div>

	<div class="doors-row">
		{
			doors.map((door) => (
				<a
					class="door"
					href={door.href}
					data-door
					data-hover-card
					data-label={door.title}
					data-cursor="Go in"
				>
					<div class="door-face" data-door-face>
						<HoverVideo
							stem={door.stem}
							poster={door.poster}
							aspect="4:5"
							class="door-film"
						/>
						<span class="door-streak" aria-hidden="true" />
						<span class="door-shade" aria-hidden="true" />
						<span class="door-copy">
							<h3 class="door-title label-box">{door.title}</h3>
							<p class="door-line">{door.line}</p>
							<span class="door-go label">
								Go in
								<svg viewBox="0 0 32 16" aria-hidden="true" focusable="false">
									<path d="M0 8h26M18 2l8 6-8 6" />
								</svg>
							</span>
						</span>
					</div>
				</a>
			))
		}
	</div>
</section>

<script>
	import { bootDoors } from "../../scripts/home-doors";

	bootDoors();
</script>

<style>
	.doors {
		position: relative;
		background: var(--color-anti);
		padding: var(--space-64) 0 var(--space-96);
	}

	.doors-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-16);
		padding-inline: var(--space-16);
		margin-bottom: var(--space-24);
	}

	.doors-title {
		width: fit-content;
		max-width: 100%;
		margin: 0;
		font-size: clamp(2.75rem, 12vw, 3.5rem);
		white-space: nowrap;
	}

	.doors-lead {
		margin: 0 0 0 var(--space-8);
		max-width: 22ch;
		color: var(--color-bone);
		font-size: clamp(1.05rem, 3.4vw, 1.2rem);
		line-height: 1.35;
	}

	.doors-row {
		display: flex;
		gap: var(--space-16);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--space-16);
		padding: var(--space-32) var(--space-16) var(--space-32);
		scrollbar-width: none;
	}

	.doors-row::-webkit-scrollbar {
		display: none;
	}

	.door {
		flex: 0 0 78%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: block;
		color: inherit;
		text-decoration: none;
		perspective: 900px;
	}

	.door:focus-visible .door-face {
		outline: 3px solid var(--color-ignition);
		outline-offset: -6px;
	}

	.door-face {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--color-carbon);
		transform-style: preserve-3d;
	}

	.door-face :global(.door-film) {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
	}

	.door-streak {
		position: absolute;
		z-index: 1;
		top: -15%;
		bottom: -15%;
		left: 0;
		width: 38%;
		background: linear-gradient(
			100deg,
			transparent,
			rgb(255 255 255 / 0.28),
			transparent
		);
		opacity: 0;
		pointer-events: none;
		transform: translateX(-170%) skewX(-12deg);
	}

	.door-shade {
		position: absolute;
		z-index: 2;
		inset: 0;
		background: linear-gradient(
			to top,
			rgb(10 10 11 / 0.88) 0%,
			rgb(10 10 11 / 0.28) 42%,
			transparent 68%
		);
		pointer-events: none;
	}

	.door-copy {
		position: absolute;
		z-index: 3;
		right: var(--space-16);
		bottom: var(--space-16);
		left: var(--space-16);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-8);
	}

	.door-title {
		margin: 0;
		font-size: clamp(2rem, 8vw, 2.75rem);
	}

	.door-line {
		margin: 0;
		max-width: none;
		color: var(--color-bone);
		font-family: var(--font-body);
		font-size: clamp(0.95rem, 3.2vw, 1.05rem);
		line-height: 1.3;
	}

	.door-go {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		margin-top: var(--space-4);
		color: var(--color-hero);
	}

	.door-go svg {
		display: block;
		width: 28px;
		height: 14px;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: square;
	}

	.door:hover .door-go svg,
	.door:focus-visible .door-go svg {
		transform: translateX(8px);
	}

	@media (min-width: 768px) {
		.doors {
			padding: var(--space-96) 5vw var(--space-128);
		}

		.doors-head {
			padding-inline: 0;
			margin-bottom: var(--space-48);
		}

		.doors-title {
			font-size: clamp(4.5rem, 8vw, 8rem);
		}

		.doors-lead {
			margin-left: 12px;
			max-width: 26ch;
			font-size: clamp(1.2rem, 1.5vw, 1.5rem);
		}

		.doors-row {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-template-rows: auto auto;
			gap: var(--space-24) var(--space-16);
			overflow: visible;
			padding: 0;
			scroll-snap-type: none;
		}

		.door {
			flex: none;
			width: 100%;
			align-self: start;
			justify-self: stretch;
			scroll-snap-align: none;
		}

		.door:nth-child(1) {
			grid-column: 1 / 7;
			grid-row: 1;
			margin-top: 8vh;
		}

		.door:nth-child(2) {
			grid-column: 7 / 13;
			grid-row: 1;
			margin-top: 0;
		}

		.door:nth-child(3) {
			grid-column: 1 / 7;
			grid-row: 2;
			margin-top: 0;
		}

		.door:nth-child(4) {
			grid-column: 8 / 13;
			grid-row: 2;
			margin-top: 7vh;
		}

		.door-title {
			font-size: clamp(2.2rem, 3vw, 3.25rem);
		}

		.door-line {
			font-size: clamp(0.95rem, 1.05vw, 1.125rem);
			white-space: nowrap;
		}
	}

	@media (min-width: 1100px) {
		/* Wide screens: three doors on the skyline, blog on the next row. */
		.door:nth-child(1) {
			grid-column: 1 / 5;
			margin-top: 28px;
		}

		.door:nth-child(2) {
			grid-column: 5 / 8;
			margin-top: 0;
		}

		.door:nth-child(3) {
			grid-column: 8 / 12;
			grid-row: 1;
			margin-top: 16px;
		}

		.door:nth-child(4) {
			grid-column: 8 / 12;
			grid-row: 2;
			margin-top: 32px;
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.door-go svg {
			transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.door:hover .door-streak {
			opacity: 1;
			transform: translateX(340%) skewX(-12deg);
			transition:
				transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
				opacity 0.2s linear;
		}
	}

	@media (min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.door-face {
			will-change: transform;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.door-streak {
			display: none;
		}

		.door-go svg {
			transition: none;
		}
	}
</style>
