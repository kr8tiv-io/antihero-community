---
import HoverVideo from "./HoverVideo.astro";
import Raster from "./Raster.astro";
import RevealHeading from "./RevealHeading.astro";

interface Props {
	href: string;
	title: string;
	/** Short label in the card boxes. Falls back to `title`. */
	cardTitle?: string | null;
	category: string;
	summary: string;
	dateIso: string;
	dateLabel: string;
	cover: string | null;
	/** Stem such as /media/loops/guide-websites-on-autopilot. Poster is that stem plus -poster.jpg. */
	loop?: string | null;
	spot: number;
	/** First card is in view, so it must not wait on lazy loading. */
	priority?: boolean;
	/** Local PDF. A separate control, so it is not nested inside the guide link. */
	pdf?: string | null;
}

const {
	href,
	title,
	cardTitle = null,
	category,
	summary,
	dateIso,
	dateLabel,
	cover,
	loop = null,
	spot,
	priority = false,
	pdf = null,
} = Astro.props;
const categoryId = category.toLowerCase();
const displayTitle = cardTitle?.trim() || title;
---

<article
	class="guide-card"
	data-guide-card
	data-category={categoryId}
	data-spot={spot % 4}
	data-tracer="edge"
>
	<a class="guide-card__link" href={href} data-hover-card data-label={title} data-cursor="Read">
		<div class="guide-card__cover">
			<div class="guide-card__zoom" data-zoom>
				{
					loop ? (
						<HoverVideo
							stem={loop}
							poster={`${loop}-poster.jpg`}
							aspect="4:5"
							class="guide-card__film"
						/>
					) : cover ? (
						<Raster
							src={cover}
							alt={`Cover of ${title}.`}
							sizes="(min-width: 768px) 42vw, 92vw"
							widths={[480, 800, 1200]}
							loading={priority ? "eager" : "lazy"}
							fetchpriority={priority ? "high" : "auto"}
							reveal={!priority}
						/>
					) : (
						<div class="guide-card__plate">
							<span class="guide-card__plate-cat mono">{category}</span>
							<span class="guide-card__plate-note caption">Cover still to come.</span>
						</div>
					)
				}
			</div>
		</div>
		<p class="guide-card__meta">
			<span class="guide-card__cat mono">{category}</span>
			<time class="mono caption" datetime={dateIso}>
				{dateLabel}
			</time>
		</p>
		<div class="guide-card__title">
			<RevealHeading as="h2" text={displayTitle} label={title} wordsPerLine={2} />
		</div>
		<p class="guide-card__summary">{summary}</p>
	</a>
	{
		pdf && (
			<a class="guide-card__pdf label" href={pdf} download>
				PDF
				<span class="visually-hidden"> of {title}</span>
			</a>
		)
	}
</article>

<style>
	.guide-card {
		min-width: 0;
		scroll-margin-top: calc(var(--header-h) + 5.75rem);
	}

	.guide-card.is-gone {
		display: none;
		pointer-events: none;
	}

	.guide-card__link {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.guide-card__link:focus-visible {
		outline: 2px solid var(--color-ignition);
		outline-offset: 4px;
	}

	.guide-card__cover {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--color-graphite);
	}

	.guide-card__zoom {
		height: 100%;
	}

	.guide-card__zoom :global(.guide-card__film) {
		height: 100%;
		aspect-ratio: auto;
	}

	.guide-card__zoom :global(picture),
	.guide-card__zoom :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.guide-card__plate {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		padding: var(--space-16);
		background: var(--color-graphite);
	}

	.guide-card__plate-cat {
		color: var(--color-bone);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.guide-card__plate-note {
		align-self: flex-end;
		max-width: 16ch;
		margin: 0;
		color: var(--color-bone);
		text-align: right;
	}

	.guide-card__meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-16);
		max-width: none;
		margin: 0;
	}

	.guide-card__cat {
		color: var(--color-bone);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.guide-card__title {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		container-type: inline-size;
	}

	/* The heading is a child component, so the size has to target it from this wrapper. */
	.guide-card__title :global(h2) {
		width: 100%;
		max-width: 100%;
		margin: 0;
		font-size: clamp(2.4rem, 4vw, 4.25rem);
		line-height: 0.88;
	}

	/* Stay inside the column. The reveal still clips the slide-up. */
	.guide-card__title :global(.reveal-heading__line) {
		max-width: 100%;
	}

	.guide-card__title :global(.reveal-heading__text) {
		display: block;
		max-width: 100%;
		overflow-wrap: anywhere;
		white-space: nowrap;
		/* Bebas runs about 0.38em a letter. Shrink only when the line cannot fit. */
		font-size: min(1em, calc((100cqi - 0.55em) / (var(--title-chars, 10) * 0.42)));
	}

	.guide-card__title :global(.reveal-heading__text.is-long) {
		line-height: 1;
		white-space: normal;
	}

	.guide-card__summary {
		margin: 0;
		color: var(--color-bone);
	}

	.guide-card__pdf {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		min-height: 44px;
		margin-top: calc(var(--space-8) * -1);
		color: var(--color-hero);
		text-decoration: none;
		text-underline-offset: 0.22em;
	}

	.guide-card__pdf:hover {
		text-decoration: underline;
	}

	.guide-card__pdf:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 3px;
	}

	@media (min-width: 768px) {
		.guide-card[data-spot="0"] {
			grid-column: 1 / span 6;
		}

		.guide-card[data-spot="1"] {
			grid-column: 8 / span 5;
			margin-top: clamp(4rem, 16vh, 11rem);
		}

		.guide-card[data-spot="2"] {
			grid-column: 2 / span 5;
		}

		.guide-card[data-spot="3"] {
			grid-column: 7 / span 5;
			margin-top: clamp(2rem, 8vh, 6rem);
		}
	}


</style>
