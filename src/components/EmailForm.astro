---
import { facebookGroupUrl } from "../data/nav";

interface Props {
  id: string;
  compact?: boolean;
}

const { id, compact = false } = Astro.props;

// Matt: paste the real bot-field name from the Mailchimp embed code.
// It is the off-screen text input, named like b_0123abc_4567def. Replace b_TODO_TODO.
const botFieldName = "b_TODO_TODO";

const rawAction = import.meta.env.MAILCHIMP_FORM_ACTION;
const actionText = typeof rawAction === "string" ? rawAction.trim() : "";
let action = "";
if (actionText) {
  try {
    const url = new URL(actionText);
    if (url.protocol === "https:") action = url.href;
  } catch {
    action = "";
  }
}
const ready = action.length > 0;
---

{
  ready ? (
    <form
      class:list={["email-form", { "email-form--compact": compact }]}
      method="post"
      action={action}
      target="_blank"
    >
      <div class="email-form__row">
        <label class="visually-hidden" for={id}>
          Email
        </label>
        <span class="email-field">
          <input
            id={id}
            type="email"
            name="EMAIL"
            required
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            placeholder="you@email.com"
          />
          <span class="email-field__line" aria-hidden="true"></span>
        </span>
        <button class="email-form__submit" type="submit">
          <span class="swap-label">
            <span class="swap-label__line">Send me the good stuff</span>
            <span class="swap-label__line" aria-hidden="true">Send me the good stuff</span>
          </span>
          <span class="email-check" aria-hidden="true">
            <span class="email-check__bar email-check__bar--short"></span>
            <span class="email-check__bar email-check__bar--long"></span>
          </span>
        </button>
      </div>
      <div class="visually-hidden" aria-hidden="true">
        <input type="text" name={botFieldName} tabindex="-1" value="" autocomplete="off" />
      </div>
      <p class="email-form__note caption">
        One email when there's something worth your time. Unsubscribe whenever.
      </p>
    </form>
  ) : (
    <div class:list={["email-form", { "email-form--compact": compact }]}>
      <div class="email-form__row">
        <label class="visually-hidden" for={id}>
          Email
        </label>
        <span class="email-field">
          <input id={id} type="email" name="EMAIL" autocomplete="email" disabled value="" />
          <span class="email-field__line" aria-hidden="true"></span>
        </span>
        <button class="email-form__submit" type="button" disabled>
          <span class="swap-label">
            <span class="swap-label__line">Send me the good stuff</span>
            <span class="swap-label__line" aria-hidden="true">Send me the good stuff</span>
          </span>
          <span class="email-check" aria-hidden="true">
            <span class="email-check__bar email-check__bar--short"></span>
            <span class="email-check__bar email-check__bar--long"></span>
          </span>
        </button>
      </div>
      <p class="email-form__note caption">
        Email list opens soon. The group is already open.{" "}
        <a href={facebookGroupUrl} target="_blank" rel="noopener noreferrer">
          Join the group
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  )
}

<style>
  .email-form__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
  }

  .email-form--compact .email-form__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-8);
  }

  .email-field {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
  }

  .email-form--compact .email-field {
    flex: 1 1 12rem;
    width: auto;
  }

  .email-form input[type="email"] {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-12);
    border: 1px solid var(--color-ash);
    border-radius: 0;
    background: var(--color-graphite);
    color: var(--color-hero);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.2;
  }

  .email-field__line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-ignition);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  .email-field:focus-within .email-field__line {
    transform: scaleX(1);
  }

  .email-form input[type="email"]::placeholder {
    color: var(--color-bone);
  }

  .email-form input[type="email"]:focus-visible {
    outline: 2px solid var(--color-ignition);
    outline-offset: 3px;
  }

  .email-form input[type="email"]:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .email-form__submit {
    position: relative;
    min-height: 48px;
    padding: 0 var(--space-16);
    border: 1px solid var(--color-hero);
    border-radius: 0;
    background: transparent;
    color: var(--color-hero);
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .email-form__submit:hover:not(:disabled) {
    background: var(--color-hero);
    color: var(--color-anti);
  }

  .email-form__submit:active:not(:disabled) {
    background: var(--color-ember);
    color: var(--color-hero);
    border-color: var(--color-ember);
  }

  .email-form__submit.is-sent,
  .email-form__submit.is-sent:hover,
  .email-form__submit.is-sent:active {
    background: var(--color-ember);
    color: var(--color-hero);
    border-color: var(--color-ember);
  }

  .email-form__submit.is-sent .swap-label {
    opacity: 0;
  }

  .email-check {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .email-form__submit.is-sent .email-check {
    opacity: 1;
  }

  .email-check__bar {
    position: absolute;
    height: 2px;
    background: var(--color-hero);
    transform-origin: left center;
  }

  .email-check__bar--short {
    top: 11px;
    left: 2px;
    width: 6px;
    transform: rotate(45deg) scaleX(0);
  }

  .email-check__bar--long {
    top: 15px;
    left: 6px;
    width: 12px;
    transform: rotate(-45deg) scaleX(0);
  }

  .email-form__submit.is-sent .email-check__bar--short {
    transform: rotate(45deg) scaleX(1);
  }

  .email-form__submit.is-sent .email-check__bar--long {
    transform: rotate(-45deg) scaleX(1);
  }

  .email-form__submit:focus-visible {
    outline: 2px solid var(--color-ignition);
    outline-offset: 3px;
  }

  .email-form__submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .email-form__note {
    margin: var(--space-12) 0 0;
    max-width: 42ch;
    text-wrap: pretty;
  }

  .email-form__note a {
    display: inline-block;
    min-height: 44px;
    padding-block: 12px;
    color: var(--color-hero);
    text-underline-offset: 0.18em;
  }

  .email-form__note a:hover {
    color: var(--color-bone);
  }

  .email-form__note a:focus-visible {
    outline: 2px solid var(--color-ignition);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .email-field__line,
    .email-check,
    .email-form__submit .swap-label {
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.12s linear;
    }

    .email-check__bar {
      transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .email-check__bar--long {
      transition-delay: 0.1s;
    }
  }
</style>
