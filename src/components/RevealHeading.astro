---
interface Line {
	text: string;
	red?: boolean;
}

interface Props {
	as?: "h1" | "h2";
	lines?: Line[];
	text?: string;
	/** 0 keeps the whole string in one box. Cards use 2. */
	wordsPerLine?: number;
	/** Accessible name when the visible boxes are a shorter label. */
	label?: string;
	id?: string;
	class?: string;
}

const {
	as: Tag = "h2",
	lines,
	text = "",
	wordsPerLine = 0,
	label,
	id,
	class: className,
} = Astro.props;

function splitWords(value: string, per: number): Line[] {
	const words = value.trim().split(/\s+/).filter(Boolean);
	if (words.length === 0) return [{ text: value }];
	if (!per || per < 1) return [{ text: words.join(" ") }];
	const out: Line[] = [];
	for (let i = 0; i < words.length; i += per) {
		out.push({ text: words.slice(i, i + per).join(" ") });
	}
	return out;
}

const items = lines && lines.length > 0 ? lines : splitWords(text, wordsPerLine);
const accessible = label?.trim();
const named = accessible && accessible !== text.trim() ? accessible : undefined;

function lineLength(value: string): { chars: number; long: boolean } {
	const words = value.split(/\s+/).filter(Boolean);
	const awkward = words.some((word) => word.length >= 12 || (/[-:]/.test(word) && word.length >= 10));
	return { chars: Math.max(value.length, 1), long: value.length > 16 || awkward };
}
---

<Tag
	id={id}
	class:list={["label-stack", "reveal-heading", className]}
	data-reveal-heading
	aria-label={named}
>
	{
		items.map((line) => {
			const fit = lineLength(line.text);
			return (
				<span
					class:list={[
						"label-box",
						"reveal-heading__line",
						line.red ? "label-box--red" : "label-box--white",
					]}
				>
					<span
						class:list={["reveal-heading__text", fit.long && "is-long"]}
						style={`--title-chars: ${fit.chars}`}
					>
						{line.text}
					</span>
				</span>
			);
		})
	}
</Tag>

<style>
	.reveal-heading__line {
		overflow: hidden;
		max-width: 100%;
		transform-origin: left center;
	}

	.reveal-heading__text {
		display: block;
	}

	/* A heading box is not a button. Red stays ignition. */
	.reveal-heading .label-box--red:hover,
	.reveal-heading .label-box--red:active {
		background: var(--color-ignition);
	}
</style>
