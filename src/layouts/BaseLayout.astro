---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import JoinBand from "../components/JoinBand.astro";
import Seo from "../components/Seo.astro";
import { normalizePath } from "../data/nav";
import { SITE_URL } from "../data/site";
import "../styles/global.css";
/* Client scripts drop this file in the static build. The layout import keeps the stopped-scroll lock. */
import "lenis/dist/lenis.css";
import appIconSvg from "../assets/brand/antihero-app-icon.svg?url";
import appIcon180 from "../assets/brand/antihero-app-icon_180px.png";
import appIcon512 from "../assets/brand/antihero-app-icon_512px.png";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
  publishedTime?: string;
  jsonLd?: string;
}

const { title, description, image, canonical, type, publishedTime, jsonLd } = Astro.props;
const path = normalizePath(Astro.url.pathname);
const showJoinBand = path !== "/" && path !== "/join";
const rssUrl = new URL("/rss.xml", Astro.site ?? SITE_URL).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0A0A0B" />
		<Seo
			title={title}
			description={description}
			image={image}
			canonical={canonical}
			type={type}
			publishedTime={publishedTime}
		/>
		<link rel="alternate" type="application/rss+xml" title="AntiHero AI" href={rssUrl} />
		{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
		<link rel="preload" href="/fonts/BebasNeue-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Barlow-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href={appIconSvg} />
		<link rel="icon" type="image/png" sizes="180x180" href={appIcon180.src} />
		<link rel="icon" type="image/png" sizes="512x512" href={appIcon512.src} />
		<link rel="apple-touch-icon" sizes="180x180" href={appIcon180.src} />
	</head>
	<body class="bg-anti font-body text-hero">
		<a class="skip-link label-box label-box--red" href="#content">Skip to content</a>
		<Header />
		<slot name="header" />
		<main id="content" tabindex="-1">
			<slot name="main" />
		</main>
		{showJoinBand && <JoinBand variant="page" />}
		<Footer />
		<slot name="footer" />
		<script>
			import { initSmoothScroll } from "../scripts/smooth-scroll";
			import { bootReveals } from "../scripts/reveals";

			initSmoothScroll();
			bootReveals();
		</script>
	</body>
</html>
