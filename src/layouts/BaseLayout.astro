---
import Seo from "../components/Seo.astro";
import "../styles/global.css";
import appIconSvg from "../assets/brand/antihero-app-icon.svg?url";
import appIcon180 from "../assets/brand/antihero-app-icon_180px.png";
import appIcon512 from "../assets/brand/antihero-app-icon_512px.png";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const { title, description, image, canonical, type } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0A0A0B" />
		<Seo title={title} description={description} image={image} canonical={canonical} type={type} />
		<link rel="preload" href="/fonts/BebasNeue-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Barlow-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href={appIconSvg} />
		<link rel="icon" type="image/png" sizes="180x180" href={appIcon180.src} />
		<link rel="icon" type="image/png" sizes="512x512" href={appIcon512.src} />
		<link rel="apple-touch-icon" sizes="180x180" href={appIcon180.src} />
	</head>
	<body class="bg-anti font-body text-hero">
		<a class="skip-link label-box label-box--red" href="#content">Skip to content</a>
		<slot name="header" />
		<main id="content" tabindex="-1">
			<slot name="main" />
		</main>
		<slot name="footer" />
	</body>
</html>
