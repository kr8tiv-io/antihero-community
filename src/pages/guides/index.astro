---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import FilterShelf from "../../components/FilterShelf.astro";
import GuideCard from "../../components/GuideCard.astro";
import RevealHeading from "../../components/RevealHeading.astro";
import { facebookGroupUrl } from "../../data/nav";
import BaseLayout from "../../layouts/BaseLayout.astro";

/** Published only. Newest UTC date first, featured wins a same-day tie, then slug. */
const guides = await getCollection("guides", ({ data }) => data.draft === false);
guides.sort((a, b) => {
	const byDate = b.data.date.getTime() - a.data.date.getTime();
	if (byDate !== 0) return byDate;
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.slug.localeCompare(b.data.slug);
});

const lines = ["The guides.", "Read them,", "steal them,", "use them."];

function localMedia(urlPath: string): string | null {
	if (!urlPath.startsWith("/") || urlPath.startsWith("//")) return null;
	const relative = decodeURIComponent(urlPath.split("?")[0]?.slice(1) ?? "");
	if (!relative || relative.split("/").includes("..")) return null;
	const file = join(process.cwd(), "public", ...relative.split("/").filter(Boolean));
	return existsSync(file) ? urlPath : null;
}

function guideDate(date: Date): { iso: string; label: string } {
	const y = date.getUTCFullYear();
	const m = String(date.getUTCMonth() + 1).padStart(2, "0");
	const d = String(date.getUTCDate()).padStart(2, "0");
	return { iso: `${y}-${m}-${d}`, label: `${y}.${m}.${d}` };
}
---

<BaseLayout
	title="Guides"
	description="Every guide from every live, in one place. No email wall."
	image="/media/door-guides-poster.jpg"
>
	<div slot="main" class="guides" data-guides>
		<header class="guides-hero" data-reveal="stagger">
			<RevealHeading
				as="h1"
				id="guides-title"
				class="guides-title"
				lines={lines.map((line) => ({ text: line }))}
			/>
			<p class="guides-intro" data-reveal="fade-up">
				Every guide from every live, in one place. No email wall.
			</p>
		</header>

		<FilterShelf
			label="Filter guides by category"
			controls="guide-grid"
			shelfSelector="[data-guides] [data-filter-shelf]"
			cardSelector="[data-guides] [data-guide-card]"
			emptySelector="[data-guides] [data-guide-empty]"
		>
		<div class="guide-grid" id="guide-grid" data-guide-grid data-reveal="stagger">
			{
				guides.map((guide, index) => {
					const date = guideDate(guide.data.date);
					const loopStem = guide.data.loop;
					const loop =
						loopStem &&
						localMedia(`${loopStem}.mp4`) &&
						localMedia(`${loopStem}.webm`) &&
						localMedia(`${loopStem}-poster.jpg`)
							? loopStem
							: null;
					return (
						<GuideCard
							href={`/guides/${guide.data.slug}`}
							title={guide.data.title}
							cardTitle={guide.data.cardTitle}
							category={guide.data.category}
							summary={guide.data.summary[0]}
							dateIso={date.iso}
							dateLabel={date.label}
							cover={localMedia(guide.data.cover)}
							loop={loop}
							pdf={localMedia(guide.data.pdf)}
							spot={index}
							priority={index === 0}
						/>
					);
				})
			}
		</div>

		<div class="guide-empty" data-guide-empty hidden>
			<p class="guide-empty__copy">Nothing here yet. Next live, probably.</p>
			<p class="guide-empty__action">
				<a href={facebookGroupUrl} target="_blank" rel="noopener noreferrer">
					Join the group
					<span class="visually-hidden"> (opens in a new tab)</span>
				</a>
			</p>
		</div>
		<p class="visually-hidden" data-guide-status aria-live="polite"></p>
		</FilterShelf>
	</div>
</BaseLayout>

<script>
	import { bootGuidesFilter } from "../../scripts/guides-filter";

	bootGuidesFilter();
</script>

<style>
	.guides-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		gap: var(--space-32);
		min-height: 58vh;
		padding: calc(var(--header-h) + var(--space-48)) var(--space-16) var(--space-32);
	}

	.guides-title {
		margin: 0;
		font-size: var(--type-h1-size);
		line-height: 0.86;
	}

	.guides-intro {
		margin: 0;
		max-width: 28ch;
		color: var(--color-bone);
	}

	.guide-grid {
		position: relative;
		z-index: 1;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: var(--space-48);
		padding: var(--space-48) var(--space-16) var(--space-96);
		scroll-margin-top: calc(var(--header-h) + 5.75rem);
	}

	.guide-empty {
		padding: 0 var(--space-16) var(--space-96);
	}

	.guide-empty__copy {
		max-width: 12ch;
		margin: 0 0 var(--space-16);
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 0.9;
		text-transform: uppercase;
		color: var(--color-hero);
	}

	.guide-empty__action {
		margin: 0;
	}

	.guide-empty a {
		color: var(--color-hero);
		font-family: var(--font-label);
		font-size: var(--type-label-size);
		font-weight: 700;
		letter-spacing: var(--type-label-tracking);
		text-transform: uppercase;
		text-underline-offset: 0.2em;
	}

	.guide-empty a:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 3px;
	}

	@media (min-width: 768px) {
		.guide-grid {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--space-24);
			row-gap: var(--space-64);
			align-items: start;
		}
	}

	@media (min-width: 1024px) {
		.guides-hero {
			display: grid;
			grid-template-columns: minmax(0, 1.45fr) minmax(14rem, 0.7fr);
			align-items: end;
			min-height: 74vh;
			padding: calc(var(--header-h) + var(--space-64)) 8vw var(--space-48) 12vw;
		}

		.guides-intro {
			justify-self: end;
		}

		.guide-grid {
			padding: var(--space-64) 8vw var(--space-128) 12vw;
		}

		.guide-empty {
			padding: 0 8vw var(--space-128) 12vw;
		}
	}

</style>
