---
import { Picture } from "astro:assets";
import about from "../assets/media/about.jpg";
import RevealHeading from "../components/RevealHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const widths = [640, 1280, 1920, 2560].filter((size) => size <= about.width);

const lines = [
	{ text: "Nobody's coming", red: false },
	{ text: "to save you.", red: false },
	{ text: "Good news,", red: false },
	{ text: "you don't need them.", red: true },
];
---

<BaseLayout
	title="About"
	description="Nobody's coming to save you. Good news, you don't need them."
>
	<div slot="main" class="about">
		<section class="about-hero" data-about-hero aria-labelledby="about-title">
			<div class="about-hero__photo" data-about-photo>
				<div class="about-hero__clip" data-reveal="clip">
					<Picture
						src={about}
						formats={["avif", "webp"]}
						alt="A lone figure on a cliff above the clouds, with a giant red planet."
						widths={widths}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</div>
			<div class="about-hero__mist" data-about-mist aria-hidden="true"></div>
			<div class="about-hero__shade" aria-hidden="true"></div>
			<div class="about-hero__copy" data-about-copy>
				<RevealHeading as="h1" id="about-title" class="about-hero__title" lines={lines} />
			</div>
		</section>

		<section class="about-mission" data-reveal="stagger" aria-label="What this is">
			<article class="about-block about-block--jobs">
				<p class="about-num"><span class="mono" data-reveal-count aria-hidden="true">01</span></p>
				<RevealHeading
					as="h2"
					lines={[{ text: "AI for people" }, { text: "with real jobs." }]}
				/>
				<p data-reveal="fade-up">Most AI content is made by people who sell AI content.</p>
				<p data-reveal="fade-up">This is for plumbers, bakers, and anyone with a business to run.</p>
			</article>

			<article class="about-block about-block--receipts">
				<p class="about-num"><span class="mono" data-reveal-count aria-hidden="true">02</span></p>
				<RevealHeading as="h2" lines={[{ text: "We show" }, { text: "the receipts." }]} />
				<p data-reveal="fade-up">Every guide comes from a real live build, mistakes included.</p>
			</article>

			<article class="about-block about-block--catch">
				<p class="about-num"><span class="mono" data-reveal-count aria-hidden="true">03</span></p>
				<RevealHeading as="h2" text="No catch." />
				<p data-reveal="fade-up">The group costs nothing and sells nothing.</p>
				<p data-reveal="fade-up">If that ever changes, you'll hear it from Matt first.</p>
			</article>

			<p class="caption about-review" data-reveal="fade-up">TODO: Matt reviews this copy.</p>
		</section>

		<section class="about-founder" data-reveal="stagger" aria-label="A note from Matt">
			<div class="about-portrait" data-reveal="clip">
				<picture><source srcset="/founders/matt.webp" type="image/webp" /><img src="/founders/matt.jpg" alt="Matt Haynes walking his French bulldog along a beach at sunset, the dog carrying a stick." width="600" height="800" loading="lazy" decoding="async" /></picture>
			</div>
			<div class="about-note" data-reveal="fade-up">
				<p>TODO: Matt writes this note. A few plain sentences, first person.</p>
				<p class="about-sign">Matt</p>
			</div>
		</section>
	</div>
</BaseLayout>

<script>
	import { bootAboutParallax } from "../scripts/about-parallax";

	bootAboutParallax();
</script>

<style>
	.about-hero {
		position: relative;
		height: 100dvh;
		overflow: hidden;
		background: var(--color-anti);
	}

	.about-hero__photo,
	.about-hero__mist,
	.about-hero__shade {
		position: absolute;
		pointer-events: none;
	}

	.about-hero__photo {
		top: -14%;
		left: -4%;
		width: 108%;
		height: 128%;
	}

	.about-hero__clip {
		width: 100%;
		height: 100%;
	}

	.about-hero__photo :global(picture),
	.about-hero__photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-hero__mist {
		top: -22%;
		left: -10%;
		z-index: 1;
		width: 120%;
		height: 144%;
		background:
			radial-gradient(ellipse 58% 26% at 18% 74%, rgb(236 232 225 / 0.18), transparent 70%),
			radial-gradient(ellipse 42% 20% at 82% 46%, rgb(236 232 225 / 0.12), transparent 68%),
			radial-gradient(ellipse 74% 28% at 48% 92%, rgb(236 232 225 / 0.22), transparent 72%);
	}

	.about-hero__shade {
		z-index: 1;
		inset: 0;
		background: linear-gradient(to top, rgb(10 10 11 / 0.55) 0%, transparent 46%);
	}

	.about-hero__copy {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 0 var(--space-16) var(--space-32);
	}

	.about-hero__title {
		margin: 0;
		max-width: 12em;
		font-size: clamp(2.05rem, 9vw, 3.5rem);
	}

	.about-hero__title .label-box {
		max-width: 100%;
	}

	.about-hero__title .label-box--red:hover,
	.about-hero__title .label-box--red:active {
		background: var(--color-ignition);
	}

	.about-mission {
		padding: var(--space-96) var(--space-16) var(--space-64);
	}

	.about-block {
		max-width: 40rem;
	}

	.about-block + .about-block {
		margin-top: var(--space-96);
	}

	.about-block .about-num {
		max-width: none;
		margin: 0 0 var(--space-12);
		color: var(--color-ignition);
		font-size: clamp(1.15rem, 2vw, 1.5rem);
	}

	.about-block h2 {
		max-width: none;
		margin: 0 0 var(--space-16);
	}

	.about-block p {
		max-width: 34ch;
		margin: 0;
		color: var(--color-bone);
	}

	.about-block p + p {
		margin-top: var(--space-12);
	}

	.about-block--jobs h2 {
		max-width: none;
		font-size: clamp(2.6rem, 10vw, 4.6rem);
	}

	.about-block--receipts {
		margin-left: 14%;
	}

	.about-block--receipts h2 {
		max-width: none;
	}

	.about-block--catch {
		margin-top: var(--space-128);
	}

	.about-block--catch h2 {
		max-width: none;
		font-size: clamp(4.2rem, 18vw, 7.5rem);
		line-height: 0.84;
	}

	.about-review {
		margin: var(--space-64) 0 0;
	}

	.about-founder {
		display: grid;
		gap: var(--space-32);
		padding: var(--space-96) var(--space-16) var(--space-128);
		overflow-x: clip;
	}

	.about-portrait {
		display: flex;
		align-items: flex-end;
		aspect-ratio: 3 / 4;
		max-width: 16rem;
		padding: var(--space-16);
		background: var(--color-graphite);
	}

	.about-portrait:has(picture) {
		padding: 0;
		overflow: hidden;
	}

	.about-portrait picture,
	.about-portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-portrait p {
		margin: 0;
	}

	.about-note p {
		max-width: 34ch;
		margin: 0;
		color: var(--color-bone);
	}

	.about-note .about-sign {
		max-width: none;
		margin-top: var(--space-32);
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 14vw, 6rem);
		line-height: 0.86;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--color-hero);
	}

	@media (min-width: 768px) {
		.about-hero__copy {
			padding: 0 0 var(--space-64) 7vw;
		}

		.about-hero__title {
			font-size: clamp(3.4rem, 5.2vw, 6.2rem);
		}

		.about-mission {
			padding: var(--space-192) 8vw var(--space-96) 7vw;
		}

		.about-block--jobs h2 {
			font-size: clamp(3.4rem, 5vw, 5.4rem);
		}

		.about-block--receipts {
			max-width: 32rem;
			margin-top: var(--space-192);
			margin-left: 46%;
		}

		.about-block--catch {
			margin-top: var(--space-192);
			margin-left: 6%;
		}

		.about-block--catch h2 {
			font-size: clamp(6rem, 12vw, 10rem);
		}

		.about-review {
			margin-top: var(--space-96);
			margin-left: 6%;
		}

		.about-founder {
			grid-template-columns: minmax(12rem, 0.34fr) minmax(0, 0.5fr);
			align-items: end;
			padding: var(--space-192) 18vw var(--space-192) 7vw;
		}

		.about-portrait {
			max-width: none;
		}

		.about-note {
			margin-bottom: var(--space-48);
		}
	}

	@media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
		.about-hero.is-live .about-hero__photo,
		.about-hero.is-live .about-hero__mist,
		.about-hero.is-live .about-hero__copy {
			will-change: transform;
		}
	}

	@media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
		.about-hero.is-live .about-hero__photo {
			will-change: transform;
		}
	}
</style>
