---
import { getCollection } from "astro:content";
import RevealHeading from "../../components/RevealHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

/** Dev shows drafts. Production builds hide them. Newest UTC date first. */
const posts = await getCollection(
	"blog",
	({ data }) => !import.meta.env.PROD || data.draft === false,
);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id));

function stamp(date: Date): { iso: string; label: string } {
	const y = date.getUTCFullYear();
	const m = String(date.getUTCMonth() + 1).padStart(2, "0");
	const d = String(date.getUTCDate()).padStart(2, "0");
	return { iso: `${y}-${m}-${d}`, label: `${y}.${m}.${d}` };
}

const notes = posts.map((post) => {
	const date = stamp(post.data.date);
	return {
		id: post.id,
		title: post.data.title,
		description: post.data.description,
		dateIso: date.iso,
		dateLabel: date.label,
		draft: post.data.draft,
	};
});
---

<BaseLayout
	title="Blog"
	description="Short posts about what worked, what broke, and what I'd do differently."
>
	<div slot="main" class="notes">
		<header class="notes-hero" data-reveal="stagger">
			<p class="notes-tools" data-reveal="fade-up">
				<a class="notes-rss label" href="/rss.xml">RSS</a>
			</p>
			<RevealHeading
				as="h1"
				lines={[{ text: "Notes from" }, { text: "the trenches." }]}
			/>
			<p class="notes-intro" data-reveal="fade-up">
				Short posts about what worked, what broke, and what I'd do differently.
			</p>
		</header>

		{
			notes.length > 0 ? (
				<ul class="note-list" data-reveal="stagger">
					{notes.map((note) => (
						<li>
							<a class="note" href={`/blog/${note.id}`}>
								<span class="note-kicker">
									<time class="mono" datetime={note.dateIso}>
										{note.dateLabel}
									</time>
									{note.draft && <span class="note-draft label-box label-box--white">DRAFT</span>}
								</span>
								<span class="note-copy">
									<RevealHeading as="h2" class="note-title" text={note.title} wordsPerLine={2} />
									<p class="note-desc" data-reveal="fade-up">{note.description}</p>
								</span>
								<svg
									class="note-arrow"
									viewBox="0 0 40 16"
									width="40"
									height="16"
									aria-hidden="true"
									focusable="false"
								>
									<path
										d="M0 8h36M28 1.5 38.5 8 28 14.5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
									/>
								</svg>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="notes-empty" data-reveal="fade-up">No notes yet.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.notes-hero {
		display: grid;
		padding: calc(var(--header-h) + var(--space-16)) var(--space-16) var(--space-48);
	}

	.notes-tools {
		display: flex;
		justify-content: flex-end;
		width: 100%;
		max-width: none;
		margin: 0;
	}

	.notes-rss {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-ash);
		text-decoration: none;
	}

	.notes-rss:hover {
		color: var(--color-bone);
	}

	.notes-hero h1 {
		max-width: none;
		margin: var(--space-8) 0 0;
	}

	.notes-intro {
		max-width: 32ch;
		margin: var(--space-24) 0 0;
		color: var(--color-bone);
	}

	.note-list {
		margin: 0;
		padding: 0 0 var(--space-96);
		list-style: none;
	}

	.note {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: var(--space-16);
		row-gap: var(--space-12);
		align-items: center;
		padding: var(--space-24) var(--space-16);
		border-top: 1px solid var(--color-graphite);
		color: inherit;
		text-decoration: none;
	}

	.note-list li:last-child .note {
		border-bottom: 1px solid var(--color-graphite);
	}

	.note-kicker {
		display: flex;
		flex-wrap: wrap;
		grid-column: 1 / -1;
		gap: var(--space-12);
		align-items: center;
	}

	.note-kicker time {
		color: var(--color-bone);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}

	.note-draft {
		font-size: 1.15rem;
	}

	.note-copy {
		min-width: 0;
	}

	.note-title {
		margin: 0;
		max-width: 100%;
		font-size: clamp(2rem, 8vw, 2.75rem);
		line-height: 0.9;
	}

	.note-desc {
		margin: var(--space-8) 0 0;
		overflow: hidden;
		color: var(--color-bone);
		font-size: var(--type-body-size);
		line-height: var(--type-body-leading);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.note-arrow {
		display: block;
		flex-shrink: 0;
		width: 2.5rem;
		height: 1rem;
		color: var(--color-ignition);
	}

	.notes-empty {
		margin: 0;
		padding: var(--space-32) var(--space-16) var(--space-128);
		border-top: 1px solid var(--color-graphite);
		color: var(--color-bone);
	}

	.notes-rss:focus-visible,
	.note:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 4px;
	}

	@media (min-width: 768px) {
		.notes-hero {
			grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
			column-gap: var(--space-64);
			align-items: end;
			padding: calc(var(--header-h) + var(--space-48)) 4vw var(--space-96) 7vw;
		}

		.notes-tools {
			grid-column: 1 / -1;
			margin-bottom: var(--space-48);
		}

		.notes-hero h1 {
			grid-column: 1;
			margin: 0;
			font-size: clamp(4.75rem, 8.5vw, 8.25rem);
			line-height: 0.84;
		}

		.notes-intro {
			grid-column: 2;
			max-width: 28ch;
			margin: 0 0 0.4em;
		}

		.note {
			grid-template-columns: 11rem minmax(0, 1fr) auto;
			align-items: center;
			padding-inline: 7vw;
		}

		.note-kicker {
			grid-column: 1;
			grid-row: 1;
			flex-direction: column;
			align-items: flex-start;
		}

		.note-copy {
			grid-column: 2;
			grid-row: 1;
		}

		.note-arrow {
			grid-column: 3;
			grid-row: 1;
		}

		.note-title {
			font-size: clamp(2.4rem, 4vw, 3.75rem);
		}

		.notes-empty {
			padding-inline: 7vw;
		}
	}

	@media (min-width: 768px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.note-arrow {
			transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.note:hover .note-arrow,
		.note:focus-visible .note-arrow {
			transform: translateX(0.75rem);
		}
	}
</style>
