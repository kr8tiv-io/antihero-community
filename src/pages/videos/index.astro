---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import RevealHeading from "../../components/RevealHeading.astro";
import VideoCard from "../../components/VideoCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const videos = await getCollection("videos");
videos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));

const guides = await getCollection("guides");
const guideById = new Map(guides.map((guide) => [guide.id, guide]));

function localMedia(urlPath: string): string | null {
	if (!urlPath.startsWith("/") || urlPath.startsWith("//")) return null;
	const relative = decodeURIComponent(urlPath.split("?")[0]?.slice(1) ?? "");
	if (!relative || relative.split("/").includes("..")) return null;
	const file = join(process.cwd(), "public", ...relative.split("/").filter(Boolean));
	return existsSync(file) ? urlPath : null;
}

function mediaSrc(value: string | undefined): string | null {
	if (!value) return null;
	if (/^https?:\/\//.test(value)) return value;
	return localMedia(value);
}

function stamp(date: Date): { iso: string; label: string } {
	const y = date.getUTCFullYear();
	const m = String(date.getUTCMonth() + 1).padStart(2, "0");
	const d = String(date.getUTCDate()).padStart(2, "0");
	return { iso: `${y}-${m}-${d}`, label: `${y}.${m}.${d}` };
}

function guideLink(source: { id: string } | undefined): { href: string; title: string } | null {
	if (!source) return null;
	const guide = guideById.get(source.id);
	if (!guide || guide.data.draft) return null;
	return { href: `/guides/${guide.data.slug}`, title: guide.data.title };
}

type Kind = "live" | "clip" | "promo";

function kindOf(video: (typeof videos)[number]): Kind {
	if (video.data.kind === "live" || video.data.kind === "clip" || video.data.kind === "promo") {
		return video.data.kind;
	}
	if (video.data.videoUrl?.includes("/media/clips/")) {
		return video.id.startsWith("promo-") ? "promo" : "clip";
	}
	return "live";
}

const cards = videos.map((video) => {
	const guide = guideLink(video.data.guide);
	const loopStem = video.data.loop;
	const loop =
		loopStem && localMedia(`${loopStem}.mp4`) && localMedia(`${loopStem}.webm`) && localMedia(`${loopStem}-poster.jpg`)
			? loopStem
			: null;
	const poster = mediaSrc(video.data.poster) ?? (loop ? `${loop}-poster.jpg` : null);
	const date = stamp(video.data.date);
	const kind = kindOf(video);
	return {
		id: video.id,
		title: video.data.title,
		dateIso: date.iso,
		dateLabel: date.label,
		duration: video.data.duration ?? null,
		poster,
		loop,
		guideHref: guide?.href ?? null,
		guideTitle: guide?.title ?? null,
		kind,
		placeholder: video.data.placeholder === true || !mediaSrc(video.data.videoUrl),
		fbUrl: video.data.fbUrl ?? null,
	};
});

const lives = cards.filter((card) => card.kind === "live");
const clips = cards.filter((card) => card.kind === "clip");
const promos = cards.filter((card) => card.kind === "promo");
const lead = lives[0];
const liveRest = lives.slice(1);

const groups = [
	{
		id: "live",
		kicker: "01",
		title: "Live replays",
		line: "The full night, from the start.",
		cards: liveRest,
		compact: false,
	},
	{
		id: "clips",
		kicker: "02",
		title: "Clips",
		line: "The part worth keeping.",
		cards: clips,
		compact: false,
	},
	{
		id: "promos",
		kicker: "03",
		title: "Promos",
		line: "10 seconds, then the live.",
		cards: promos,
		compact: true,
	},
].filter((group) => group.cards.length > 0);
---

<BaseLayout
	title="Videos"
	description="Every live, minus the buffering. Replays of every live. Watch the parts you need, skip the part where I fight the screen share."
>
	<div slot="main" class="videos" data-videos>
		<header class="videos-hero" data-reveal="stagger">
			<RevealHeading
				as="h1"
				lines={[{ text: "Every live," }, { text: "minus the buffering." }]}
			/>
			<p data-reveal="fade-up">
				Replays of every live. Watch the parts you need, skip the part where I fight the screen share.
			</p>
		</header>

		{
			lead && (
				<div class="video-lead">
					<VideoCard
						id={lead.id}
						title={lead.title}
						dateIso={lead.dateIso}
						dateLabel={lead.dateLabel}
						duration={lead.duration}
						poster={lead.poster}
						loop={lead.loop}
						guideHref={lead.guideHref}
						guideTitle={lead.guideTitle}
						lead
						placeholder={lead.placeholder}
						fbUrl={lead.fbUrl}
					/>
				</div>
			)
		}

		{
			groups.map((group) => (
				<section class:list={["video-group", `video-group--${group.id}`]} aria-labelledby={`videos-${group.id}`}>
					<header class="group-head">
						<p class="group-kicker mono">{group.kicker}</p>
						<RevealHeading as="h2" id={`videos-${group.id}`} text={group.title} />
						<p class="group-line">{group.line}</p>
					</header>
					<div class:list={["group-grid", group.compact && "group-grid--compact"]}>
						{group.cards.map((card) => (
							<VideoCard
								id={card.id}
								title={card.title}
								dateIso={card.dateIso}
								dateLabel={card.dateLabel}
								duration={card.duration}
								poster={card.poster}
								loop={card.loop}
								guideHref={card.guideHref}
								guideTitle={card.guideTitle}
								lead={false}
								compact={group.compact}
								placeholder={card.placeholder}
								fbUrl={card.fbUrl}
							/>
						))}
					</div>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.videos {
		overflow-x: clip;
	}

	.videos-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-24);
		padding: calc(var(--header-h) + var(--space-32)) var(--space-16) var(--space-48);
	}

	.videos-hero h1 {
		max-width: none;
		margin: 0;
	}

	.videos-hero p {
		max-width: 28ch;
		margin: 0;
		color: var(--color-bone);
	}

	.video-lead,
	.video-group {
		padding: 0 var(--space-16) var(--space-64);
	}

	.video-group--promos {
		padding-bottom: var(--space-96);
	}

	.group-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-12);
		max-width: 16ch;
		margin-bottom: var(--space-32);
	}

	.group-kicker {
		margin: 0;
		color: var(--color-bone);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
	}

	.group-head h2 {
		margin: 0;
		font-size: clamp(2.4rem, 8vw, 4.5rem);
	}

	.group-line {
		margin: 0;
		max-width: 22ch;
		color: var(--color-bone);
	}

	.group-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-48);
		min-width: 0;
	}

	@media (min-width: 900px) {
		.videos-hero {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(14rem, 0.45fr);
			column-gap: var(--space-48);
			align-items: end;
			padding: calc(var(--header-h) + var(--space-64)) 8vw var(--space-48) 12vw;
		}

		.videos-hero p {
			justify-self: end;
			margin-bottom: var(--space-16);
		}

		.video-lead {
			padding: 0 8vw var(--space-96) 12vw;
		}

		.video-lead :global(.video-card--lead) {
			display: grid;
			grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.72fr);
			column-gap: var(--space-48);
			align-items: end;
		}

		.video-lead :global(.video-card--lead .video-card__body) {
			max-width: 100%;
			padding-bottom: var(--space-24);
		}

		.video-group {
			padding: 0 8vw var(--space-96) 12vw;
		}

		.video-group--live .group-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.72fr);
			column-gap: var(--space-48);
			align-items: start;
		}

		.video-group--live .group-grid :global(.video-card:nth-child(even)) {
			margin-top: 8vh;
		}

		.video-group--clips .group-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			column-gap: var(--space-32);
			align-items: start;
		}

		.video-group--clips .group-grid :global(.video-card:nth-child(2)) {
			margin-top: 14vh;
		}

		.video-group--promos {
			display: grid;
			grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
			column-gap: var(--space-32);
			align-items: end;
			padding-bottom: var(--space-128);
		}

		.video-group--promos .group-head {
			margin-bottom: 0;
		}

		.group-grid--compact {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: var(--space-16);
		}
	}
</style>
