---
import JoinBand from "../components/JoinBand.astro";
import Hero from "../components/home/Hero.astro";
import LatestDrop from "../components/home/LatestDrop.astro";
import LibraryDoors from "../components/home/LibraryDoors.astro";
import Promise from "../components/home/Promise.astro";
import { facebookGroupUrl } from "../data/nav";
import { SITE_URL } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "AntiHero AI",
	url: SITE_URL,
	sameAs: [facebookGroupUrl],
}).replace(/</g, "\\u003c");
---

<BaseLayout
	title="AntiHero AI"
	description="AI for people with real jobs. No jargon, no catch."
	image="/og/og.jpg"
	jsonLd={jsonLd}
>
	<div class="home-melt" slot="main">
		<Hero />
		<Promise />
	</div>
	<LibraryDoors slot="main" />
	<LatestDrop slot="main" />
	<JoinBand slot="main" variant="home" />
</BaseLayout>

<style>
	/* Keeps the hero-over-promise stack from painting on top of the rest of the page. */
	.home-melt {
		position: relative;
		isolation: isolate;
	}
</style>
