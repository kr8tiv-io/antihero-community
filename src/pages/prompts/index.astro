---
import { getCollection } from "astro:content";
import FilterShelf from "../../components/FilterShelf.astro";
import PromptCard from "../../components/PromptCard.astro";
import RevealHeading from "../../components/RevealHeading.astro";
import { facebookGroupUrl } from "../../data/nav";
import BaseLayout from "../../layouts/BaseLayout.astro";

const prompts = await getCollection("prompts");
prompts.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

const guides = await getCollection("guides");
const guideById = new Map(guides.map((guide) => [guide.id, guide]));

function sourceLink(source: { id: string } | undefined): { href: string; title: string } | null {
	if (!source) return null;
	const guide = guideById.get(source.id);
	if (!guide || guide.data.draft) return null;
	return { href: `/guides/${guide.data.slug}`, title: guide.data.title };
}
---

<BaseLayout
	title="Prompts"
	description="Prompts that actually work. Tested on a live audience. Copy it, paste it into Grok or any decent AI, fill in the brackets."
>
	<div slot="main" class="prompts" data-prompts>
		<header class="prompts-hero" data-reveal="stagger">
			<RevealHeading
				as="h1"
				lines={[
					{ text: "Prompts that actually work." },
					{ text: "Tested on a live audience." },
				]}
			/>
			<p data-reveal="fade-up">Copy it, paste it into Grok or any decent AI, fill in the brackets.</p>
		</header>

		<FilterShelf
			label="Filter prompts by category"
			controls="prompt-grid"
			shelfSelector="[data-prompts] [data-filter-shelf]"
			cardSelector="[data-prompts] [data-prompt-card]"
			emptySelector="[data-prompts] [data-prompt-empty]"
		>
			<div class="prompt-grid" id="prompt-grid" data-prompt-grid data-reveal="stagger">
				{
					prompts.map((prompt, index) => {
						const source = sourceLink(prompt.data.source);
						return (
							<PromptCard
								id={prompt.id}
								title={prompt.data.title}
								useItFor={prompt.data.useItFor}
								category={prompt.data.category}
								body={prompt.body ?? ""}
								sourceHref={source?.href ?? null}
								sourceTitle={source?.title ?? null}
								spot={index}
							/>
						);
					})
				}
			</div>

			<div class="prompt-empty" data-prompt-empty hidden>
				<p class="prompt-empty__copy">No prompts in this category yet.</p>
				<p class="prompt-empty__action">
					<a href={facebookGroupUrl} target="_blank" rel="noopener noreferrer">
						Join the group
						<span class="visually-hidden"> (opens in a new tab)</span>
					</a>
				</p>
			</div>
			<p class="visually-hidden" data-prompt-status aria-live="polite"></p>
		</FilterShelf>
	</div>
</BaseLayout>

<script>
	import { bootFilterShelf } from "../../scripts/filter-shelf";
	import { bootPromptCards } from "../../scripts/prompt-cards";

	bootFilterShelf({
		root: "[data-prompts]",
		grid: "[data-prompt-grid]",
		card: "[data-prompt-card]",
		empty: "[data-prompt-empty]",
		status: "[data-prompt-status]",
		shelf: "[data-filter-shelf]",
		noun: "prompt",
		emptyStatus: "No prompts in this category yet.",
		readyKey: "promptsReady",
	});
	bootPromptCards();
</script>

<style>
	.prompts-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-24);
		padding: calc(var(--header-h) + var(--space-32)) var(--space-16) var(--space-32);
	}

	.prompts-hero h1 {
		max-width: none;
		margin: 0;
	}

	.prompts-hero p {
		max-width: 28ch;
		margin: 0;
		color: var(--color-bone);
	}

	.prompt-grid {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-64);
		padding: var(--space-48) var(--space-16) var(--space-96);
	}

	.prompt-empty {
		padding: 0 var(--space-16) var(--space-96);
	}

	.prompt-empty__copy {
		max-width: 14ch;
		margin: 0 0 var(--space-16);
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 0.9;
		text-transform: uppercase;
		color: var(--color-hero);
	}

	.prompt-empty__action {
		margin: 0;
	}

	.prompt-empty a {
		color: var(--color-hero);
		font-family: var(--font-label);
		font-size: var(--type-label-size);
		font-weight: 700;
		letter-spacing: var(--type-label-tracking);
		text-transform: uppercase;
		text-underline-offset: 0.2em;
	}

	.prompt-empty a:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 3px;
	}

	@media (min-width: 768px) {
		.prompt-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			column-gap: var(--space-48);
			row-gap: var(--space-64);
			align-items: start;
		}

		.prompt-grid :global([data-prompt-card][data-spot="1"]),
		.prompt-grid :global([data-prompt-card][data-spot="3"]) {
			margin-top: clamp(4rem, 12vh, 8rem);
		}
	}

	@media (min-width: 1024px) {
		.prompts-hero {
			display: grid;
			grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.7fr);
			align-items: end;
			min-height: 56vh;
			padding: calc(var(--header-h) + var(--space-64)) 8vw var(--space-48) 12vw;
		}

		.prompts-hero p {
			justify-self: end;
		}

		.prompt-grid {
			padding: var(--space-64) 8vw var(--space-128) 12vw;
		}

		.prompt-empty {
			padding: 0 8vw var(--space-128) 12vw;
		}
	}
</style>
