---
import { getCollection } from "astro:content";
import PromptCard from "../../components/PromptCard.astro";
import PromptGoalMenu from "../../components/PromptGoalMenu.astro";
import RevealHeading from "../../components/RevealHeading.astro";
import { promptCountLabel, promptGoals, type PromptGoalId } from "../../data/prompt-goals";
import BaseLayout from "../../layouts/BaseLayout.astro";

const prompts = await getCollection("prompts");
prompts.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

const guides = await getCollection("guides");
const guideById = new Map(guides.map((guide) => [guide.id, guide]));

function sourceLink(source: { id: string } | undefined): { href: string; title: string } | null {
	if (!source) return null;
	const guide = guideById.get(source.id);
	if (!guide || guide.data.draft) return null;
	return { href: `/guides/${guide.data.slug}`, title: guide.data.title };
}

const grouped = new Map<PromptGoalId, typeof prompts>();
for (const prompt of prompts) {
	const list = grouped.get(prompt.data.goal) ?? [];
	list.push(prompt);
	grouped.set(prompt.data.goal, list);
}

const sections = promptGoals.flatMap((goal) => {
	const items = grouped.get(goal.id);
	if (!items || items.length === 0) return [];
	return [{ ...goal, prompts: items }];
});

const menuGoals = sections.map((section) => ({
	id: section.id,
	label: section.label,
	description: section.description,
	count: section.prompts.length,
}));
---

<BaseLayout
	title="Prompts"
	description="Prompts that actually work. Tested on a live audience. Copy it, paste it into Grok or any decent AI, fill in the brackets."
>
	<div slot="main" class="prompts" data-prompts>
		<header class="prompts-hero" data-reveal="stagger">
			<RevealHeading
				as="h1"
				lines={[
					{ text: "Prompts that actually work." },
					{ text: "Tested on a live audience." },
				]}
			/>
			<p data-reveal="fade-up">Copy it, paste it into Grok or any decent AI, fill in the brackets.</p>
		</header>

		<PromptGoalMenu goals={menuGoals} />

		{
			sections.map((section, index) => {
				const wide = section.prompts.length < 4;
				const side = index % 2 === 0 ? "left" : "right";
				return (
					<section
						id={`goal-${section.id}`}
						class:list={["goal-section", `goal-section--${side}`]}
						aria-labelledby={`goal-${section.id}-title`}
						data-goal-section
						data-goal={section.id}
						data-label={section.label}
						data-count-label={promptCountLabel(section.prompts.length)}
					>
						<header
							class="goal-head"
							data-reveal="shift"
							data-shift={side === "right" ? "out" : undefined}
						>
							<h2
								id={`goal-${section.id}-title`}
								class="goal-title label-stack"
								tabindex="-1"
								data-goal-title
							>
								<span class="label-box label-box--white">{section.label}</span>
							</h2>
							<p class="goal-desc">{section.description}</p>
							<p class="goal-count mono">{promptCountLabel(section.prompts.length)}</p>
						</header>
						<div
							class:list={["prompt-grid", wide ? "prompt-grid--wide" : "prompt-grid--offset"]}
							data-reveal="stagger"
						>
							{section.prompts.map((prompt, spot) => {
								const source = sourceLink(prompt.data.source);
								return (
									<PromptCard
										id={prompt.id}
										title={prompt.data.title}
										useItFor={prompt.data.useItFor}
										category={prompt.data.category}
										body={prompt.body ?? ""}
										sourceHref={source?.href ?? null}
										sourceTitle={source?.title ?? null}
										spot={spot}
									/>
								);
							})}
						</div>
					</section>
				);
			})
		}
	</div>
</BaseLayout>

<script>
	import { bootPromptCards } from "../../scripts/prompt-cards";
	import { bootPromptGoals } from "../../scripts/prompt-goal-menu";

	bootPromptCards();
	bootPromptGoals();
</script>

<style>
	.prompts-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-24);
		padding: calc(var(--header-h) + var(--space-32)) var(--space-16) var(--space-16);
	}

	.prompts-hero h1 {
		max-width: none;
		margin: 0;
	}

	.prompts-hero p {
		max-width: 28ch;
		margin: 0;
		color: var(--color-bone);
	}

	.goal-section {
		scroll-margin-top: calc(var(--header-h) + var(--space-24));
		padding: var(--space-32) var(--space-16) var(--space-16);
		overflow-x: clip;
	}

	.goal-section + .goal-section {
		padding-top: var(--space-96);
	}

	.goal-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-12);
		max-width: 22ch;
		margin-bottom: var(--space-48);
	}

	.goal-title {
		margin: 0;
		font-size: clamp(3.25rem, 7vw, 6.5rem);
		line-height: 0.86;
	}

	.goal-title:focus {
		outline: 2px solid var(--color-hero);
		outline-offset: 6px;
	}

	.goal-title .label-box {
		font-size: inherit;
	}

	.goal-desc {
		max-width: 28ch;
		margin: 0;
		color: var(--color-bone);
	}

	.goal-count {
		margin: 0;
		color: var(--color-bone);
		font-size: 0.85rem;
	}

	.prompt-grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-64);
	}

	.prompt-grid--wide {
		max-width: 72rem;
	}

	@media (max-width: 767px), (pointer: coarse) {
		:global(body:has(.prompts)) {
			padding-bottom: calc(5rem + env(safe-area-inset-bottom));
		}
	}

	@media (min-width: 768px) {
		.goal-section--right .goal-head {
			align-items: flex-end;
			max-width: none;
			width: min(100%, 34rem);
			margin-left: 18%;
			text-align: right;
		}

		.prompt-grid--offset {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			column-gap: var(--space-48);
			row-gap: var(--space-64);
			align-items: start;
		}

		.prompt-grid--offset :global([data-prompt-card][data-spot="1"]),
		.prompt-grid--offset :global([data-prompt-card][data-spot="3"]) {
			margin-top: clamp(4rem, 12vh, 8rem);
		}
	}

	@media (min-width: 1024px) {
		.prompts-hero {
			display: grid;
			grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 0.7fr);
			align-items: end;
			min-height: 52vh;
			padding: calc(var(--header-h) + var(--space-64)) 8vw var(--space-16) 12vw;
		}

		.prompts-hero p {
			justify-self: end;
		}

		.goal-section {
			padding: var(--space-48) 8vw var(--space-32) 12vw;
		}

		.goal-section + .goal-section {
			padding-top: var(--space-128);
		}

		.goal-section--right .goal-head {
			margin-left: 32%;
		}
	}
</style>
