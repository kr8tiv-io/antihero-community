---
import { creditCategories, credits } from "../data/credits";
import BaseLayout from "../layouts/BaseLayout.astro";

const groups = creditCategories
	.map((category) => ({
		category,
		items: credits.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);

const intro = "AntiHero stands on the generosity of open-source makers. Thank you.";
---

<BaseLayout title="Credits" description={intro}>
	<article slot="main" class="credits">
		<header class="credits-hero">
			<h1 class="credits-title">
				<span class="label-box label-box--red">Credits</span>
			</h1>
			<p class="credits-lead" data-reveal="fade-up">{intro}</p>
		</header>

		{
			groups.map((group) => (
				<section class="credits-group" aria-labelledby={`credits-${group.category.replaceAll(" ", "-")}`}>
					<h2 id={`credits-${group.category.replaceAll(" ", "-")}`} class="credits-cat label" data-reveal="fade-up">
						{group.category}
					</h2>
					<ul class="credits-list">
						{group.items.map((item) => (
							<li class="credits-row" data-reveal="fade-up">
								<a class="credits-name" href={item.link} target="_blank" rel="noopener noreferrer">
									{item.name}
									<span class="visually-hidden"> (opens in a new tab)</span>
								</a>
								<p class="credits-author">{item.author}</p>
								{item.licenseLink ? (
									<a class="credits-license mono" href={item.licenseLink} target="_blank" rel="noopener noreferrer">
										{item.license}
										<span class="visually-hidden"> (opens in a new tab)</span>
									</a>
								) : (
									<p class="credits-license mono">{item.license}</p>
								)}
								<p class="credits-use">{item.usedFor}</p>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</article>
</BaseLayout>

<style>
	.credits {
		padding: calc(var(--header-h) + var(--space-48)) var(--space-16) var(--space-128);
	}

	.credits-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-32);
		max-width: 46rem;
	}

	.credits-title {
		margin: 0;
		font-size: clamp(4.5rem, 18vw, 8.5rem);
		line-height: 0.84;
	}

	.credits-lead {
		max-width: 28ch;
		margin: 0;
		color: var(--color-bone);
		font-size: var(--type-body-size);
		line-height: var(--type-body-leading);
	}

	.credits-group {
		display: grid;
		gap: var(--space-24);
		margin-top: var(--space-80);
	}

	.credits-cat {
		margin: 0;
		color: var(--color-hero);
	}

	.credits-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.credits-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.15rem var(--space-16);
		align-items: baseline;
		padding: var(--space-24) 0;
		border-top: 1px solid var(--color-graphite);
	}

	.credits-row:last-child {
		border-bottom: 1px solid var(--color-graphite);
	}

	.credits-name,
	.credits-license {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
	}

	.credits-name {
		color: var(--color-hero);
		font-family: var(--font-body);
		font-size: clamp(1.2rem, 2.4vw, 1.65rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: 0;
		text-transform: none;
	}

	.credits-name:hover {
		color: var(--color-bone);
	}

	.credits-author,
	.credits-use,
	.credits-license {
		margin: 0;
		color: var(--color-bone);
	}

	.credits-license {
		justify-self: start;
		color: var(--color-hero);
	}

	a.credits-license:hover {
		color: var(--color-bone);
	}

	.credits-use {
		max-width: 52ch;
	}

	@media (min-width: 768px) {
		.credits {
			padding: calc(var(--header-h) + var(--space-96)) 8vw var(--space-192) 6vw;
		}

		.credits-hero {
			margin-left: 8vw;
		}

		.credits-group {
			grid-template-columns: minmax(8.5rem, 14rem) minmax(0, 46rem);
			column-gap: clamp(2rem, 6vw, 5rem);
			align-items: start;
			margin-top: var(--space-96);
		}

		.credits-group:nth-of-type(even) {
			grid-template-columns: minmax(12rem, 20rem) minmax(0, 40rem);
		}

		.credits-row {
			grid-template-columns: minmax(0, 1.3fr) minmax(8rem, 0.9fr) minmax(7rem, auto);
			grid-template-areas:
				"name author license"
				"use use use";
		}

		.credits-name {
			grid-area: name;
		}

		.credits-author {
			grid-area: author;
		}

		.credits-license {
			grid-area: license;
			justify-self: end;
			text-align: right;
		}

		.credits-use {
			grid-area: use;
		}
	}
</style>
