---
import RevealHeading from "../components/RevealHeading.astro";
import { creditCategories, credits } from "../data/credits";
import BaseLayout from "../layouts/BaseLayout.astro";

const groups = creditCategories
	.map((category) => ({
		category,
		items: credits.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
---

<BaseLayout title="Credits" description="What this site borrows, and who licensed it.">
	<article slot="main" class="credits">
		<header class="credits-hero" data-reveal="stagger">
			<RevealHeading as="h1" id="credits-title" class="credits-title" text="Credits" />
			<p class="credits-lead" data-reveal="fade-up">What this site borrows, and who licensed it.</p>
		</header>

		{
			groups.map((group) => (
				<section class="credits-group" data-reveal="stagger">
					<RevealHeading as="h2" class="credits-group__title" text={group.category} />
					<ol class="credits-list">
						{group.items.map((item, index) => (
							<li>
								<span class="credits-num mono" data-reveal-count aria-hidden="true">
									{String(index + 1).padStart(2, "0")}
								</span>
								<a
									class="credits-name"
									href={item.link}
									target="_blank"
									rel="noopener noreferrer"
								>
									{item.name}
									<span class="visually-hidden"> (opens in a new tab)</span>
								</a>
								<p class="credits-use">{item.usedFor}</p>
								<p class="caption credits-meta">
									{item.author}.{" "}
									{item.licenseLink ? (
										<a href={item.licenseLink} target="_blank" rel="noopener noreferrer">
											{item.license}
											<span class="visually-hidden"> (opens in a new tab)</span>
										</a>
									) : (
										item.license
									)}
									.
								</p>
							</li>
						))}
					</ol>
				</section>
			))
		}
	</article>
</BaseLayout>

<style>
	.credits {
		padding: calc(var(--header-h) + var(--space-48)) var(--space-16) var(--space-128);
	}

	.credits-hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-24);
		max-width: 40rem;
	}

	.credits-title {
		margin: 0;
		font-size: clamp(4.5rem, 18vw, 8.5rem);
		line-height: 0.84;
	}

	.credits-lead {
		max-width: 26ch;
		margin: 0;
		color: var(--color-bone);
	}

	.credits-group {
		max-width: 44rem;
		margin-top: var(--space-96);
	}

	.credits-group:nth-of-type(even) {
		margin-left: clamp(0rem, 14vw, 12rem);
	}

	.credits-group__title {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3.4rem);
	}

	.credits-list {
		margin: var(--space-32) 0 0;
		padding: 0;
		list-style: none;
	}

	.credits-list li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		column-gap: var(--space-16);
		padding: var(--space-24) 0;
		border-top: 1px solid var(--color-graphite);
	}

	.credits-list li:last-child {
		border-bottom: 1px solid var(--color-graphite);
	}

	.credits-num {
		grid-row: 1 / span 3;
		color: var(--color-ignition);
		font-size: 1.05rem;
	}

	.credits-name {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.25rem);
		line-height: 0.9;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-hero);
	}

	.credits-name:hover {
		color: var(--color-bone);
	}

	.credits-name:focus-visible,
	.credits-meta a:focus-visible {
		outline: 2px solid var(--color-hero);
		outline-offset: 3px;
	}

	.credits-use {
		max-width: 42ch;
		margin: var(--space-8) 0 0;
		color: var(--color-bone);
	}

	.credits-meta {
		margin: var(--space-4) 0 0;
	}

	.credits-meta a {
		color: inherit;
	}

	@media (min-width: 768px) {
		.credits {
			padding: calc(var(--header-h) + var(--space-96)) 8vw var(--space-192) 10vw;
		}

		.credits-group:nth-of-type(3) {
			margin-left: 4vw;
		}
	}
</style>
